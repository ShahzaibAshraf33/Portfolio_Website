# ─────────────────────────────────────────────────────────────────────────────
# Next.js & Web Application .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js Build Output & Cache
/.next/
/out/
/build

# TypeScript Build Cache
*.tsbuildinfo
next-env.d.ts

# Vercel Deployment Cache
.vercel

# ─────────────────────────────────────────────────────────────────────────────
# Security & Secret Credentials (Never commit to Git)
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# SSL & Encryption Keys
*.pem
*.key
*.cert
*.crt
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.keystore
secrets.*

# Debug & Error Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating System & Editor Files
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Design Reference Mockups & Documents
*.docx
3d design.webp
colors.jpeg
hero design.png
image.jpeg
portfolio-design-mockup.jpg
redeign my image.png
shahzaib-portrait.jpeg
scripts/
